# SEG workspace configuration — TEMPLATE.
# Copy to the workspace root as `seg.yaml` and adjust paths to your environment:
#     cp g-graph/seg.yaml.example ../seg.yaml
# `seg.yaml` itself is UNTRACKED (it lives at the container root, outside every
# worktree); this committed example is the versioned reference (DEC-002).
#
# The logical repo keys repoA..repoG are independent of the git branch names
# (reqs / impl / results / graph); they map to the worktree directories.
repos:
  repoA: "./a-reqs"      # branch reqs    — requirements (doc/requirements/)
  repoB: "./b-impl"      # branch impl    — implementation + test specs
  repoC: "./c-results"   # branch results — raw test outcomes
  repoG: "./g-graph"     # branch graph   — graph state

tools:
  extractor_requirements: "seg extract requirements"
  extractor_implementations: "seg extract implementations"
  extractor_test_specs: "seg extract test-specs"
  extractor_test_outcomes: "seg extract test-outcomes"
