  p_entropy [label=<<b>p_entropy</b><br/><font point-size="8" color="#555555">requirement</font><br/><font point-size="9">[satisfied]</font>>, shape=box, style=filled, fillcolor="#b7e4c7", color="#495057"];
  p_hal [label=<<b>p_hal</b><br/><font point-size="8" color="#555555">requirement</font><br/><font point-size="9">[satisfied]</font>>, shape=box, style=filled, fillcolor="#b7e4c7", color="#495057"];
  p_mem [label=<<b>p_mem</b><br/><font point-size="8" color="#555555">requirement</font><br/><font point-size="9">[satisfied]</font>>, shape=box, style=filled, fillcolor="#b7e4c7", color="#495057"];
  p_rng_a [label=<<b>p_rng_a</b><br/><font point-size="8" color="#555555">requirement</font><br/><font point-size="9">[satisfied]</font>>, shape=box, style=filled, fillcolor="#b7e4c7", color="#495057"];
  g_m_hal [label=<<b>g_m_hal</b><br/><font point-size="8" color="#555555">guarantee</font>>, shape=doubleoctagon, style=filled, fillcolor="#cdb4db", color="#495057"];
  m_clk [label=<<b>m_clk</b><br/><font point-size="8" color="#555555">requirement</font><br/><font point-size="9">[satisfied]</font>>, shape=box, style=filled, fillcolor="#b7e4c7", color="#495057"];
  m_pwr [label=<<b>m_pwr</b><br/><font point-size="8" color="#555555">requirement</font><br/><font point-size="9">[satisfied]</font>>, shape=box, style=filled, fillcolor="#b7e4c7", color="#495057"];
  dr0 [label=<<b>dr0</b><br/><font point-size="8" color="#555555">designreview</font>>, shape=diamond, style=filled, fillcolor="#caffbf", color="#495057"];
  dr1 [label=<<b>dr1</b><br/><font point-size="8" color="#555555">designreview</font>>, shape=diamond, style=filled, fillcolor="#caffbf", color="#495057"];
  dr2 [label=<<b>dr2</b><br/><font point-size="8" color="#555555">designreview</font>>, shape=diamond, style=filled, fillcolor="#caffbf", color="#495057"];
  dr3 [label=<<b>dr3</b><br/><font point-size="8" color="#555555">designreview</font>>, shape=diamond, style=filled, fillcolor="#caffbf", color="#495057"];
  dr4 [label=<<b>dr4</b><br/><font point-size="8" color="#555555">designreview</font>>, shape=diamond, style=filled, fillcolor="#caffbf", color="#495057"];
  d_impl -> man_up [label="uses", color="#868e96", style=dashed, penwidth=1.0, arrowhead=normal, fontsize=9, fontcolor="#868e96"];
  d_impl -> man_sup [label="uses", color="#868e96", style=dashed, penwidth=1.0, arrowhead=normal, fontsize=9, fontcolor="#868e96"];
  d_req -> d_sys [label="refines", color="#333333", style=solid, penwidth=1.4, arrowhead=normal, fontsize=9, fontcolor="#333333"];
