  g_m_hal -> m_clk [label="assumes", color="#e8590c", style=solid, penwidth=2.2, arrowhead=normal, fontsize=9, fontcolor="#e8590c"];
  g_m_hal -> m_pwr [label="assumes", color="#e8590c", style=solid, penwidth=2.2, arrowhead=normal, fontsize=9, fontcolor="#e8590c"];
  g_m_hal -> p_hal [label="covers (minted)", color="#9c36b5", style=solid, penwidth=2.2, arrowhead=onormal, fontsize=9, fontcolor="#9c36b5"];
  dr0 -> m_clk [label="reviews", color="#0c8599", style=solid, penwidth=1.2, arrowhead=normal, fontsize=9, fontcolor="#0c8599"];
  dr1 -> m_pwr [label="reviews", color="#0c8599", style=solid, penwidth=1.2, arrowhead=normal, fontsize=9, fontcolor="#0c8599"];
