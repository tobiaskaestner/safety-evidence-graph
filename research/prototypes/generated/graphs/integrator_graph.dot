digraph SEG {
  rankdir=BT; bgcolor="white";
  node [fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica"];
  labelloc="t"; fontsize=14; label="Integrator graph - M + M' (DEC-023)";
  man_up [label=<<b>man_up</b><br/><font point-size="8" color="#555555">manifest</font>>, shape=folder, style=filled, fillcolor="#ffd6a5", color="#495057"];
  man_sup [label=<<b>man_sup</b><br/><font point-size="8" color="#555555">manifest</font>>, shape=folder, style=filled, fillcolor="#ffd6a5", color="#495057"];
  d_impl [label=<<b>d_impl</b><br/><font point-size="8" color="#555555">implementation</font>>, shape=component, style=filled, fillcolor="#e6dcf5", color="#495057"];
  d_sys [label=<<b>d_sys</b><br/><font point-size="8" color="#555555">requirement</font><br/><font point-size="9">[satisfied]</font>>, shape=box, style=filled, fillcolor="#b7e4c7", color="#495057"];
  d_req [label=<<b>d_req</b><br/><font point-size="8" color="#555555">requirement</font><br/><font point-size="9">[satisfied]</font>>, shape=box, style=filled, fillcolor="#b7e4c7", color="#495057"];
