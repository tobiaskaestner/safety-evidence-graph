  dr4 -> p_rng_a [label="reviews", color="#0c8599", style=solid, penwidth=1.2, arrowhead=normal, fontsize=9, fontcolor="#0c8599"];
  g_p_sys -> man_up [label="referenced_under", color="#adb5bd", style=dotted, penwidth=1.0, fontsize=8, fontcolor="#868e96"];
  p_entropy -> man_up [label="referenced_under", color="#adb5bd", style=dotted, penwidth=1.0, fontsize=8, fontcolor="#868e96"];
  p_hal -> man_up [label="referenced_under", color="#adb5bd", style=dotted, penwidth=1.0, fontsize=8, fontcolor="#868e96"];
  p_mem -> man_up [label="referenced_under", color="#adb5bd", style=dotted, penwidth=1.0, fontsize=8, fontcolor="#868e96"];
  p_rng_a -> man_up [label="referenced_under", color="#adb5bd", style=dotted, penwidth=1.0, fontsize=8, fontcolor="#868e96"];
  g_m_hal -> man_sup [label="referenced_under", color="#adb5bd", style=dotted, penwidth=1.0, fontsize=8, fontcolor="#868e96"];
  m_clk -> man_sup [label="referenced_under", color="#adb5bd", style=dotted, penwidth=1.0, fontsize=8, fontcolor="#868e96"];
  m_pwr -> man_sup [label="referenced_under", color="#adb5bd", style=dotted, penwidth=1.0, fontsize=8, fontcolor="#868e96"];
subgraph cluster_legend {
  label="legend"; fontsize=11; color="#adb5bd"; style="rounded";
  L_req_sat [label="requirement\n(satisfied)", shape=box, style=filled, fillcolor="#b7e4c7", fontsize=9];
  L_req_obl [label="requirement\n(obligation)", shape=box, style=filled, fillcolor="#ffe08a", fontsize=9];
  L_req_uns [label="requirement\n(unsatisfied)", shape=box, style=filled, fillcolor="#f4a3a3", fontsize=9];
  L_ts [label="testspecification", shape=ellipse, style=filled, fillcolor="#d0e6fb", fontsize=9];
  L_impl [label="implementation", shape=component, style=filled, fillcolor="#e6dcf5", fontsize=9];
  L_out [label="testoutcome", shape=note, style=filled, fillcolor="#b7e4c7", fontsize=9];
  L_guar [label="guarantee", shape=doubleoctagon, style=filled, fillcolor="#cdb4db", fontsize=9];
  L_man [label="manifest", shape=folder, style=filled, fillcolor="#ffd6a5", fontsize=9];
  L_dr [label="designreview", shape=diamond, style=filled, fillcolor="#caffbf", fontsize=9];
  L_env [label="environment", shape=box3d, style=filled, fillcolor="#c3fae8", fontsize=9];
  L_asm [label="assumption\n(imported)", shape=note, style=filled, fillcolor="#fff3bf", fontsize=9];
  L_req_sat -> L_req_obl -> L_req_uns -> L_ts -> L_impl -> L_out -> L_guar -> L_man -> L_dr -> L_env -> L_asm [style=invis];
  subgraph cluster_edges {
    label="edge types"; fontsize=10; color="#ced4da";
    E0a [shape=point, width=0.02, color="#888888"];
    E0b [shape=point, width=0.02, color="#888888"];
    E0a -> E0b [label="refines", color="#333333", style=solid, penwidth=1.4, fontsize=9, fontcolor="#333333"];
    E1a [shape=point, width=0.02, color="#888888"];
    E1b [shape=point, width=0.02, color="#888888"];
    E1a -> E1b [label="verifies", color="#1d6fb8", style=solid, penwidth=1.2, fontsize=9, fontcolor="#1d6fb8"];
    E0b -> E1a [style=invis];
    E2a [shape=point, width=0.02, color="#888888"];
    E2b [shape=point, width=0.02, color="#888888"];
    E2a -> E2b [label="implements", color="#7048e8", style=solid, penwidth=1.2, fontsize=9, fontcolor="#7048e8"];
    E1b -> E2a [style=invis];
    E3a [shape=point, width=0.02, color="#888888"];
    E3b [shape=point, width=0.02, color="#888888"];
    E3a -> E3b [label="confirms", color="#2f9e44", style=solid, penwidth=1.2, fontsize=9, fontcolor="#2f9e44"];
    E2b -> E3a [style=invis];
    E4a [shape=point, width=0.02, color="#888888"];
    E4b [shape=point, width=0.02, color="#888888"];
    E4a -> E4b [label="witnesses", color="#2f9e44", style=dashed, penwidth=1.2, fontsize=9, fontcolor="#2f9e44"];
    E3b -> E4a [style=invis];
    E5a [shape=point, width=0.02, color="#888888"];
    E5b [shape=point, width=0.02, color="#888888"];
    E5a -> E5b [label="assumes", color="#e8590c", style=solid, penwidth=2.2, fontsize=9, fontcolor="#e8590c"];
    E4b -> E5a [style=invis];
    E6a [shape=point, width=0.02, color="#888888"];
    E6b [shape=point, width=0.02, color="#888888"];
    E6a -> E6b [label="covers", color="#9c36b5", style=solid, penwidth=2.2, fontsize=9, fontcolor="#9c36b5"];
    E5b -> E6a [style=invis];
    E7a [shape=point, width=0.02, color="#888888"];
    E7b [shape=point, width=0.02, color="#888888"];
    E7a -> E7b [label="conformsTo", color="#9c36b5", style=dashed, penwidth=1.8, fontsize=9, fontcolor="#9c36b5"];
    E6b -> E7a [style=invis];
    E8a [shape=point, width=0.02, color="#888888"];
    E8b [shape=point, width=0.02, color="#888888"];
    E8a -> E8b [label="reviews", color="#0c8599", style=solid, penwidth=1.2, fontsize=9, fontcolor="#0c8599"];
    E7b -> E8a [style=invis];
    E9a [shape=point, width=0.02, color="#888888"];
    E9b [shape=point, width=0.02, color="#888888"];
    E9a -> E9b [label="uses", color="#868e96", style=dashed, penwidth=1.0, fontsize=9, fontcolor="#868e96"];
    E8b -> E9a [style=invis];
    E10a [shape=point, width=0.02, color="#888888"];
    E10b [shape=point, width=0.02, color="#888888"];
    E10a -> E10b [label="excuses", color="#e03131", style=dotted, penwidth=1.2, fontsize=9, fontcolor="#e03131"];
    E9b -> E10a [style=invis];
    E11a [shape=point, width=0.02, color="#888888"];
    E11b [shape=point, width=0.02, color="#888888"];
    E11a -> E11b [label="surrogate_for", color="#0ca678", style=dashed, penwidth=1.6, fontsize=9, fontcolor="#0ca678"];
    E10b -> E11a [style=invis];
    E12a [shape=point, width=0.02, color="#888888"];
    E12b [shape=point, width=0.02, color="#888888"];
    E12a -> E12b [label="ran_on", color="#495057", style=dotted, penwidth=1.2, fontsize=9, fontcolor="#495057"];
    E11b -> E12a [style=invis];
  }
}
}