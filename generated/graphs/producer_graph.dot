digraph SEG {
  rankdir=BT; bgcolor="white";
  node [fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica"];
  labelloc="t"; fontsize=14; label="SEG producer graph (crypto: RNG + hashing)";
  p_sys [label=<<b>p_sys</b><br/><font point-size="8" color="#555555">requirement</font><br/><font point-size="9">[satisfied]</font>>, shape=box, style=filled, fillcolor="#b7e4c7", color="#495057"];
  p_rng [label=<<b>p_rng</b><br/><font point-size="8" color="#555555">requirement</font><br/><font point-size="9">[satisfied]</font>>, shape=box, style=filled, fillcolor="#b7e4c7", color="#495057"];
  p_ts [label=<<b>p_ts</b><br/><font point-size="8" color="#555555">testspecification</font>>, shape=ellipse, style=filled, fillcolor="#d0e6fb", color="#495057"];
  p_impl [label=<<b>p_impl</b><br/><font point-size="8" color="#555555">implementation</font>>, shape=component, style=filled, fillcolor="#e6dcf5", color="#495057"];
  p_out [label=<<b>p_out</b><br/><font point-size="8" color="#555555">testoutcome</font><br/><font point-size="9">PASS</font>>, shape=note, style=filled, fillcolor="#b7e4c7", color="#495057"];
  p_sys_2 [label=<<b>p_sys_2</b><br/><font point-size="8" color="#555555">requirement</font><br/><font point-size="9">[satisfied]</font>>, shape=box, style=filled, fillcolor="#b7e4c7", color="#495057"];
  p_sha256 [label=<<b>p_sha256</b><br/><font point-size="8" color="#555555">requirement</font><br/><font point-size="9">[satisfied]</font>>, shape=box, style=filled, fillcolor="#b7e4c7", color="#495057"];
  p_sha512 [label=<<b>p_sha512</b><br/><font point-size="8" color="#555555">requirement</font><br/><font point-size="9">[satisfied]</font>>, shape=box, style=filled, fillcolor="#b7e4c7", color="#495057"];
  p_ts256 [label=<<b>p_ts256</b><br/><font point-size="8" color="#555555">testspecification</font>>, shape=ellipse, style=filled, fillcolor="#d0e6fb", color="#495057"];
  p_im256 [label=<<b>p_im256</b><br/><font point-size="8" color="#555555">implementation</font>>, shape=component, style=filled, fillcolor="#e6dcf5", color="#495057"];
  p_o256 [label=<<b>p_o256</b><br/><font point-size="8" color="#555555">testoutcome</font><br/><font point-size="9">PASS</font>>, shape=note, style=filled, fillcolor="#b7e4c7", color="#495057"];
  p_ts512 [label=<<b>p_ts512</b><br/><font point-size="8" color="#555555">testspecification</font>>, shape=ellipse, style=filled, fillcolor="#d0e6fb", color="#495057"];
  p_im512 [label=<<b>p_im512</b><br/><font point-size="8" color="#555555">implementation</font>>, shape=component, style=filled, fillcolor="#e6dcf5", color="#495057"];
  p_o512 [label=<<b>p_o512</b><br/><font point-size="8" color="#555555">testoutcome</font><br/><font point-size="9">PASS</font>>, shape=note, style=filled, fillcolor="#b7e4c7", color="#495057"];
  p_entropy [label=<<b>p_entropy</b><br/><font point-size="8" color="#555555">requirement</font><br/><font point-size="9">[obligation]</font>>, shape=box, style=filled, fillcolor="#ffe08a", color="#495057"];
  p_rng_a [label=<<b>p_rng_a</b><br/><font point-size="8" color="#555555">requirement</font><br/><font point-size="9">[obligation]</font>>, shape=box, style=filled, fillcolor="#ffe08a", color="#495057"];
  p_sha256_a [label=<<b>p_sha256_a</b><br/><font point-size="8" color="#555555">requirement</font><br/><font point-size="9">[obligation]</font>>, shape=box, style=filled, fillcolor="#ffe08a", color="#495057"];
  p_sha512_a [label=<<b>p_sha512_a</b><br/><font point-size="8" color="#555555">requirement</font><br/><font point-size="9">[obligation]</font>>, shape=box, style=filled, fillcolor="#ffe08a", color="#495057"];
  p_mem [label=<<b>p_mem</b><br/><font point-size="8" color="#555555">requirement</font><br/><font point-size="9">[obligation]</font>>, shape=box, style=filled, fillcolor="#ffe08a", color="#495057"];
  p_hal [label=<<b>p_hal</b><br/><font point-size="8" color="#555555">requirement</font><br/><font point-size="9">[obligation]</font>>, shape=box, style=filled, fillcolor="#ffe08a", color="#495057"];
  p_qemu [label=<<b>p_qemu</b><br/><font point-size="8" color="#555555">environment</font>>, shape=box3d, style=filled, fillcolor="#c3fae8", color="#495057"];
  p_rng -> p_sys [label="refines", color="#333333", style=solid, penwidth=1.4, arrowhead=normal, fontsize=9, fontcolor="#333333"];
  p_ts -> p_rng [label="verifies", color="#1d6fb8", style=solid, penwidth=1.2, arrowhead=normal, fontsize=9, fontcolor="#1d6fb8"];
  p_impl -> p_rng [label="implements", color="#7048e8", style=solid, penwidth=1.2, arrowhead=normal, fontsize=9, fontcolor="#7048e8"];
  p_out -> p_ts [label="confirms", color="#2f9e44", style=solid, penwidth=1.2, arrowhead=normal, fontsize=9, fontcolor="#2f9e44"];
  p_out -> p_impl [label="witnesses", color="#2f9e44", style=dashed, penwidth=1.2, arrowhead=normal, fontsize=9, fontcolor="#2f9e44"];
  p_sha256 -> p_sys_2 [label="refines", color="#333333", style=solid, penwidth=1.4, arrowhead=normal, fontsize=9, fontcolor="#333333"];
  p_sha512 -> p_sys_2 [label="refines", color="#333333", style=solid, penwidth=1.4, arrowhead=normal, fontsize=9, fontcolor="#333333"];
  p_ts256 -> p_sha256 [label="verifies", color="#1d6fb8", style=solid, penwidth=1.2, arrowhead=normal, fontsize=9, fontcolor="#1d6fb8"];
  p_im256 -> p_sha256 [label="implements", color="#7048e8", style=solid, penwidth=1.2, arrowhead=normal, fontsize=9, fontcolor="#7048e8"];
  p_o256 -> p_ts256 [label="confirms", color="#2f9e44", style=solid, penwidth=1.2, arrowhead=normal, fontsize=9, fontcolor="#2f9e44"];
  p_o256 -> p_im256 [label="witnesses", color="#2f9e44", style=dashed, penwidth=1.2, arrowhead=normal, fontsize=9, fontcolor="#2f9e44"];
  p_ts512 -> p_sha512 [label="verifies", color="#1d6fb8", style=solid, penwidth=1.2, arrowhead=normal, fontsize=9, fontcolor="#1d6fb8"];
  p_im512 -> p_sha512 [label="implements", color="#7048e8", style=solid, penwidth=1.2, arrowhead=normal, fontsize=9, fontcolor="#7048e8"];
  p_o512 -> p_ts512 [label="confirms", color="#2f9e44", style=solid, penwidth=1.2, arrowhead=normal, fontsize=9, fontcolor="#2f9e44"];
  p_o512 -> p_im512 [label="witnesses", color="#2f9e44", style=dashed, penwidth=1.2, arrowhead=normal, fontsize=9, fontcolor="#2f9e44"];
  p_sys -> p_entropy [label="assumes", color="#e8590c", style=solid, penwidth=2.2, arrowhead=normal, fontsize=9, fontcolor="#e8590c"];
  p_rng -> p_rng_a [label="assumes", color="#e8590c", style=solid, penwidth=2.2, arrowhead=normal, fontsize=9, fontcolor="#e8590c"];
  p_sha256 -> p_sha256_a [label="assumes", color="#e8590c", style=solid, penwidth=2.2, arrowhead=normal, fontsize=9, fontcolor="#e8590c"];
  p_sha512 -> p_sha512_a [label="assumes", color="#e8590c", style=solid, penwidth=2.2, arrowhead=normal, fontsize=9, fontcolor="#e8590c"];
  p_rng -> p_mem [label="assumes", color="#e8590c", style=solid, penwidth=2.2, arrowhead=normal, fontsize=9, fontcolor="#e8590c"];
  p_sha512 -> p_mem [label="assumes", color="#e8590c", style=solid, penwidth=2.2, arrowhead=normal, fontsize=9, fontcolor="#e8590c"];
  p_rng -> p_hal [label="assumes", color="#e8590c", style=solid, penwidth=2.2, arrowhead=normal, fontsize=9, fontcolor="#e8590c"];
  p_qemu -> p_hal [label="surrogate_for", color="#0ca678", style=dashed, penwidth=1.6, arrowhead=normal, fontsize=9, fontcolor="#0ca678"];
  p_out -> p_qemu [label="ran_on", color="#495057", style=dotted, penwidth=1.2, arrowhead=normal, fontsize=9, fontcolor="#495057"];
subgraph cluster_legend {
  label="legend"; fontsize=11; color="#adb5bd"; style="rounded";
  L_req_sat [label="requirement\n(satisfied)", shape=box, style=filled, fillcolor="#b7e4c7", fontsize=9];
  L_req_obl [label="requirement\n(obligation)", shape=box, style=filled, fillcolor="#ffe08a", fontsize=9];
  L_req_uns [label="requirement\n(unsatisfied)", shape=box, style=filled, fillcolor="#f4a3a3", fontsize=9];
  L_ts [label="testspecification", shape=ellipse, style=filled, fillcolor="#d0e6fb", fontsize=9];
  L_impl [label="implementation", shape=component, style=filled, fillcolor="#e6dcf5", fontsize=9];
  L_out [label="testoutcome", shape=note, style=filled, fillcolor="#b7e4c7", fontsize=9];
  L_guar [label="guarantee", shape=doubleoctagon, style=filled, fillcolor="#cdb4db", fontsize=9];
  L_man [label="manifest", shape=folder, style=filled, fillcolor="#ffd6a5", fontsize=9];
  L_dr [label="designreview", shape=diamond, style=filled, fillcolor="#caffbf", fontsize=9];
  L_env [label="environment", shape=box3d, style=filled, fillcolor="#c3fae8", fontsize=9];
  L_asm [label="assumption\n(imported)", shape=note, style=filled, fillcolor="#fff3bf", fontsize=9];
  L_req_sat -> L_req_obl -> L_req_uns -> L_ts -> L_impl -> L_out -> L_guar -> L_man -> L_dr -> L_env -> L_asm [style=invis];
  subgraph cluster_edges {
    label="edge types"; fontsize=10; color="#ced4da";
    E0a [shape=point, width=0.02, color="#888888"];
    E0b [shape=point, width=0.02, color="#888888"];
    E0a -> E0b [label="refines", color="#333333", style=solid, penwidth=1.4, fontsize=9, fontcolor="#333333"];
    E1a [shape=point, width=0.02, color="#888888"];
    E1b [shape=point, width=0.02, color="#888888"];
    E1a -> E1b [label="verifies", color="#1d6fb8", style=solid, penwidth=1.2, fontsize=9, fontcolor="#1d6fb8"];
    E0b -> E1a [style=invis];
    E2a [shape=point, width=0.02, color="#888888"];
    E2b [shape=point, width=0.02, color="#888888"];
    E2a -> E2b [label="implements", color="#7048e8", style=solid, penwidth=1.2, fontsize=9, fontcolor="#7048e8"];
    E1b -> E2a [style=invis];
    E3a [shape=point, width=0.02, color="#888888"];
    E3b [shape=point, width=0.02, color="#888888"];
    E3a -> E3b [label="confirms", color="#2f9e44", style=solid, penwidth=1.2, fontsize=9, fontcolor="#2f9e44"];
    E2b -> E3a [style=invis];
    E4a [shape=point, width=0.02, color="#888888"];
    E4b [shape=point, width=0.02, color="#888888"];
    E4a -> E4b [label="witnesses", color="#2f9e44", style=dashed, penwidth=1.2, fontsize=9, fontcolor="#2f9e44"];
    E3b -> E4a [style=invis];
    E5a [shape=point, width=0.02, color="#888888"];
    E5b [shape=point, width=0.02, color="#888888"];
    E5a -> E5b [label="assumes", color="#e8590c", style=solid, penwidth=2.2, fontsize=9, fontcolor="#e8590c"];
    E4b -> E5a [style=invis];
    E6a [shape=point, width=0.02, color="#888888"];
    E6b [shape=point, width=0.02, color="#888888"];
    E6a -> E6b [label="covers", color="#9c36b5", style=solid, penwidth=2.2, fontsize=9, fontcolor="#9c36b5"];
    E5b -> E6a [style=invis];
    E7a [shape=point, width=0.02, color="#888888"];
    E7b [shape=point, width=0.02, color="#888888"];
    E7a -> E7b [label="conformsTo", color="#9c36b5", style=dashed, penwidth=1.8, fontsize=9, fontcolor="#9c36b5"];
    E6b -> E7a [style=invis];
    E8a [shape=point, width=0.02, color="#888888"];
    E8b [shape=point, width=0.02, color="#888888"];
    E8a -> E8b [label="reviews", color="#0c8599", style=solid, penwidth=1.2, fontsize=9, fontcolor="#0c8599"];
    E7b -> E8a [style=invis];
    E9a [shape=point, width=0.02, color="#888888"];
    E9b [shape=point, width=0.02, color="#888888"];
    E9a -> E9b [label="uses", color="#868e96", style=dashed, penwidth=1.0, fontsize=9, fontcolor="#868e96"];
    E8b -> E9a [style=invis];
    E10a [shape=point, width=0.02, color="#888888"];
    E10b [shape=point, width=0.02, color="#888888"];
    E10a -> E10b [label="excuses", color="#e03131", style=dotted, penwidth=1.2, fontsize=9, fontcolor="#e03131"];
    E9b -> E10a [style=invis];
    E11a [shape=point, width=0.02, color="#888888"];
    E11b [shape=point, width=0.02, color="#888888"];
    E11a -> E11b [label="surrogate_for", color="#0ca678", style=dashed, penwidth=1.6, fontsize=9, fontcolor="#0ca678"];
    E10b -> E11a [style=invis];
    E12a [shape=point, width=0.02, color="#888888"];
    E12b [shape=point, width=0.02, color="#888888"];
    E12a -> E12b [label="ran_on", color="#495057", style=dotted, penwidth=1.2, fontsize=9, fontcolor="#495057"];
    E11b -> E12a [style=invis];
  }
}
}