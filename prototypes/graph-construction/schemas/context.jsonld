{
  "@context": {
    "_comment": "Shared JSON-LD context for the Safety Evidence Graph (SEG). The base IRI is project-specific (see config.json). All other terms are generic and reusable across projects.",

    "@base": "https://zephyrproject.org/safety/",
    "@vocab": "https://zephyrproject.org/seg#",

    "spdx": "https://spdx.org/rdf/3.0.1/terms/Core/",
    "seg": "https://zephyrproject.org/seg#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "id":             { "@id": "@id" },
    "type":           { "@id": "@type" },

    "name":           { "@id": "spdx:name" },
    "comment":        { "@id": "spdx:comment" },
    "description":    { "@id": "spdx:description" },

    "seg:from":               { "@id": "seg:from",              "@type": "@id" },
    "seg:to":                 { "@id": "seg:to",                "@type": "@id" },
    "seg:specId":             { "@id": "seg:specId",            "@type": "@id" },
    "seg:outcomeId":          { "@id": "seg:outcomeId",         "@type": "@id" },
    "seg:affirmingEdge":      { "@id": "seg:affirmingEdge",     "@type": "@id" },
    "seg:scope":              { "@id": "seg:scope",             "@type": "@id" },
    "seg:designConsistencyProof":  { "@id": "seg:designConsistencyProof",  "@type": "@id" },
    "seg:executionCoverageRecord": { "@id": "seg:executionCoverageRecord", "@type": "@id" },
    "seg:coverageReport":     { "@id": "seg:coverageReport",    "@type": "@id" },

    "seg:edgeHash":           { "@id": "seg:edgeHash" },
    "seg:linkState":          { "@id": "seg:linkState" },
    "seg:repoBSha":           { "@id": "seg:repoBSha" },
    "seg:repoASha":           { "@id": "seg:repoASha" },
    "seg:repoCSha":           { "@id": "seg:repoCSha" },
    "seg:repoGSha":           { "@id": "seg:repoGSha" },
    "seg:runId":              { "@id": "seg:runId" },
    "seg:outcome":            { "@id": "seg:outcome" },
    "seg:justification":      { "@id": "seg:justification" },
    "seg:expiry":             { "@id": "seg:expiry",            "@type": "xsd:date" },
    "seg:affirmingRole":      { "@id": "seg:affirmingRole" },
    "seg:snapshotId":         { "@id": "seg:snapshotId" },
    "seg:nodeManifest":       { "@id": "seg:nodeManifest" },
    "seg:merkleRoot":         { "@id": "seg:merkleRoot" },
    "seg:overallStatus":      { "@id": "seg:overallStatus" },
    "seg:sourceRepo":         { "@id": "seg:sourceRepo" },
    "seg:sourcePath":         { "@id": "seg:sourcePath" },
    "seg:subHashChanged":     { "@id": "seg:subHashChanged" },
    "seg:testRunId":          { "@id": "seg:testRunId" },
    "seg:outcomes":           { "@id": "seg:outcomes" },
    "seg:waiverId":           { "@id": "seg:waiverId",          "@type": "@id" },
    "seg:waiverExpiry":       { "@id": "seg:waiverExpiry",      "@type": "xsd:date" },
    "seg:structuralGaps":     { "@id": "seg:structuralGaps" },
    "seg:suspectLinks":       { "@id": "seg:suspectLinks" },
    "seg:staleOutcomes":      { "@id": "seg:staleOutcomes" },
    "seg:missingOutcomes":    { "@id": "seg:missingOutcomes" },
    "seg:requirementId":      { "@id": "seg:requirementId",     "@type": "@id" },
    "seg:missingEdgeTypes":   { "@id": "seg:missingEdgeTypes" },
    "seg:edgeId":             { "@id": "seg:edgeId",            "@type": "@id" },
    "seg:responsibleRole":    { "@id": "seg:responsibleRole" },
    "seg:recordedSha":        { "@id": "seg:recordedSha" },
    "seg:currentSha":         { "@id": "seg:currentSha" },
    "seg:testSpecId":         { "@id": "seg:testSpecId",        "@type": "@id" },
    "seg:nodeHash":           { "@id": "seg:nodeHash" },
    "seg:merkleHash":         { "@id": "seg:merkleHash" },

    "seg:Requirement":          { "@id": "seg:Requirement" },
    "seg:Implementation":       { "@id": "seg:Implementation" },
    "seg:TestSpecification":    { "@id": "seg:TestSpecification" },
    "seg:TestOutcome":          { "@id": "seg:TestOutcome" },
    "seg:Waiver":               { "@id": "seg:Waiver" },
    "seg:ReviewEvent":          { "@id": "seg:ReviewEvent" },
    "seg:DesignConsistencyProof":  { "@id": "seg:DesignConsistencyProof" },
    "seg:ExecutionCoverageRecord": { "@id": "seg:ExecutionCoverageRecord" },
    "seg:CoverageReport":       { "@id": "seg:CoverageReport" },
    "seg:EvidenceManifest":     { "@id": "seg:EvidenceManifest" }
  }
}
